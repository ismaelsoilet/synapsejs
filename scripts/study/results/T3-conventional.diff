+export function closeTicket(
+  payload: unknown,
+  db: Database,
+  session?: Session
+): ServiceResult<
+  { ticketId: string; status: 'CLOSED' },
+  'UNAUTHORIZED' | 'FORBIDDEN' | 'INVALID_SCHEMA' | 'TICKET_NOT_FOUND' | 'ALREADY_CLOSED'
+> {
+  if (!session) {
+    return { ok: false, error: 'UNAUTHORIZED' };
+  }
+  if (!isSupport(session)) {
+    return { ok: false, error: 'FORBIDDEN' };
+  }
+  if (!Value.Check(CloseTicketSchema, payload)) {
+    return { ok: false, error: 'INVALID_SCHEMA' };
+  }
+
+  const input = payload as { ticketId: string };
+  const existing = findTicketStatusById(db, input.ticketId);
+  if (!existing) {
+    return { ok: false, error: 'TICKET_NOT_FOUND' };
+  }
+  if (existing.status === 'CLOSED') {
+    return { ok: false, error: 'ALREADY_CLOSED' };
+  }
+
+  closeTicketRecord(db, input.ticketId);
+  return { ok: true, value: { ticketId: input.ticketId, status: 'CLOSED' } };
+}
