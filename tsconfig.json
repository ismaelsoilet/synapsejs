{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "synapsejs": ["./packages/synapse/src/index.ts"],
      "@/*": ["packages/synapse/src/*"]
    },
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "packages/synapse/src/**/*",
    "packages/synapse/bin/**/*",
    "packages/synapse/test/**/*",
    "apps/crm/src/**/*",
    "examples/enterprise-crm/src/**/*",
    "examples/enterprise-crm/scripts/**/*",
    "examples/helpdesk-slices/src/**/*",
    "examples/helpdesk-conventional/src/**/*",
    "packages/synapse/templates/starter/src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".codebase",
    "**/.synapse/**",
    "packages/synapse/test/fixtures/**"
  ]
}
