{
  "name": "synapsejs",
  "version": "0.2.0",
  "description": "Fullstack AI-Native & Machine-Centric Framework with Locality of Behavior, AST-Daemon, Zero-Wiring Bun Router and Embedded SQLite",
  "main": "src/core/index.ts",
  "type": "module",
  "bin": {
    "synapse": "./bin/synapse.ts"
  },
  "scripts": {
    "dev": "bun run bin/synapse.ts dev",
    "check": "bun run bin/synapse.ts check",
    "skeleton": "bun run bin/synapse.ts skeleton",
    "test": "bun run bin/synapse.ts test",
    "test:e2e": "bun run scripts/e2e-server-test.ts",
    "split": "bun run bin/synapse.ts split",
    "new-slice": "bun run bin/synapse.ts new-slice",
    "cli": "bun run bin/synapse.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.40",
    "fast-check": "^3.23.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  }
}
