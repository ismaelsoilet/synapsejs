{
  "name": "synapsejs-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "SynapseJS Monorepo: The Machine-Centric AI-Native Fullstack Engine",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "templates/*"
  ],
  "scripts": {
    "dev": "bun --cwd examples/enterprise-crm dev",
    "check": "bun run packages/synapse/bin/synapse.ts check",
    "check:fast": "bun run packages/synapse/bin/synapse.ts check --fast",
    "migrate": "bun --cwd examples/enterprise-crm migrate",
    "mcp": "bun run packages/synapse/bin/synapse.ts mcp",
    "skeleton": "bun --cwd examples/enterprise-crm skeleton",
    "test": "bun --cwd examples/enterprise-crm test",
    "test:e2e": "bun --cwd examples/enterprise-crm test:e2e",
    "split": "bun --cwd examples/enterprise-crm split",
    "new-slice": "bun --cwd examples/enterprise-crm new-slice",
    "build": "bun run packages/synapse/bin/synapse.ts check && bun --cwd examples/enterprise-crm skeleton",
    "test:all": "bun --cwd examples/enterprise-crm test && bun --cwd templates/starter test && bun --cwd examples/enterprise-crm test:e2e",
    "new": "bun run packages/synapse/bin/synapse.ts new",
    "cli": "bun run packages/synapse/bin/synapse.ts"
  },
  "dependencies": {
    "synapsejs": "workspace:*",
    "@sinclair/typebox": "^0.34.40",
    "fast-check": "^3.23.2",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  }
}
