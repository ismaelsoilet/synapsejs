{
  "name": "dashboard-showcase",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "synapse dev",
    "check": "synapse check",
    "migrate": "synapse migrate",
    "mcp": "synapse mcp",
    "skeleton": "synapse skeleton",
    "test": "synapse test",
    "test:gate": "synapse test --gate",
    "new-slice": "synapse new-slice",
    "split": "synapse split",
    "build:css": "tailwindcss -i src/styles/main.css -o public/synapse.css --content \"src/**/*.{ts,tsx},../../packages/synapse/src/client/**/*.{ts,tsx}\" --minify",
    "build": "bun run build:css && synapse build",
    "build:standalone": "synapse build --standalone",
    "start": "synapse start"
  },
  "dependencies": {
    "@ismaelsoilet/synapsejs": "workspace:*",
    "@sinclair/typebox": "^0.34.40",
    "fast-check": "^3.23.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  }
}
