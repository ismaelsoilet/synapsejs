{
  "name": "synapsejs",
  "version": "0.6.0",
  "description": "Bun-only fullstack framework where a feature is a single contiguous file",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "author": "Ismael Soilet <ismael.soilet@hotmail.com>",
  "keywords": [
    "ai",
    "framework",
    "agentic",
    "fullstack",
    "bun",
    "mcp",
    "machine-centric",
    "pbt",
    "typescript"
  ],
  "bin": {
    "synapse": "./bin/synapse.ts"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismaelsoilet/synapsejs.git",
    "directory": "packages/synapse"
  },
  "homepage": "https://github.com/ismaelsoilet/synapsejs#readme",
  "bugs": {
    "url": "https://github.com/ismaelsoilet/synapsejs/issues"
  },
  "scripts": {
    "check": "bun run bin/synapse.ts check",
    "mcp": "bun run bin/synapse.ts mcp",
    "info": "bun run bin/synapse.ts info",
    "test": "bun test test"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.40",
    "fast-check": "^3.23.2",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
